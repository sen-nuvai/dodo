# Local development defaults
API_TOKEN=change-me-for-local-testing
PORT=3000
RUST_LOG=info

# Optional Postgres persistence. When set, handlers use tenant-scoped
# transactions, idempotency, invoice payment locks, and durable webhooks.
DATABASE_URL=postgres://dodo:dodo@db:5432/dodo
# Required to create the first tenant in Postgres mode.
BOOTSTRAP_API_KEY=dev_prefix_dev-secret
